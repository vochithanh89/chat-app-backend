# Mail provider: we recommend using Resend (https://resend.com) or Brevo (https://brevo.com).
# For Render Free Tier (where SMTP ports 587/465 are blocked), we highly recommend Brevo via HTTP API.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=lenqvinh3010@gmail.com
# BREVO_SENDER_NAME="ChatApp Support"

# SMTP config (recommended for local environment where SMTP ports are not blocked)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=lenqvinh3010@gmail.com
# SMTP_PASSWORD=aoxhhclfwbaqakej


# Firebase Cloud Messaging (push notifications)
# Leave empty to disable FCM — NotificationService will log payloads instead of sending pushes.
# FIREBASE_PRIVATE_KEY: paste the full PEM in one line, escape newlines as \n
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI Chatbot — Google Gemini
# Get a key at https://aistudio.google.com/apikey
# Leave empty to disable the /ai endpoints (returns 503).
GEMINI_API_KEY=
GEMINI_MODEL=

S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
