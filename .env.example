TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# Firebase Cloud Messaging (push notifications)
# Leave empty to disable FCM — NotificationService will log payloads instead of sending pushes.
# FIREBASE_PRIVATE_KEY: paste the full PEM in one line, escape newlines as \n
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI Chatbot — Google Gemini
# Get a key at https://aistudio.google.com/apikey
# Leave empty to disable the /ai endpoints (returns 503).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash