TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

# Mail provider: we recommend using Resend (https://resend.com).
# If you use Resend, set RESEND_API_KEY. Otherwise, email sending will
# fall back to logging OTPs and reset tokens to the server console.
# RESEND_API_KEY=
# Default from address to use when sending emails via Resend. Must be a verified
# sender or use a verified domain in your Resend account. Example: no-reply@yourdomain.com
# RESEND_FROM=onboarding@yourdomain.com

# Firebase Cloud Messaging (push notifications)
# Leave empty to disable FCM — NotificationService will log payloads instead of sending pushes.
# FIREBASE_PRIVATE_KEY: paste the full PEM in one line, escape newlines as \n
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI Chatbot — Google Gemini
# Get a key at https://aistudio.google.com/apikey
# Leave empty to disable the /ai endpoints (returns 503).
GEMINI_API_KEY=
GEMINI_MODEL=

S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
